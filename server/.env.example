PORT=5001
# Replace the example credentials with your PostgreSQL role and password.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blogspace
# Alternatively, omit the URL password and set PGPASSWORD.
# PG_ALLOW_PASSWORDLESS=true # Only for peer/trust or other passwordless authentication.
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:5173
